    "workforce-management",
    "staffsync",
    "react19",
    "express",
    "mongodb",
    "mongoose",
    "vite",
    "bootstrap5",
    "recharts",
    "jwt",
    "attendance-tracking",
    "leave-management"
  ],
  "author": "Vansh Singh Yadav <vanshsinghyadav18@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  }
}

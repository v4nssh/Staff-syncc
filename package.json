{
  "name": "staffsync",
  "version": "1.0.0",
  "description": "StaffSync - Enterprise Human Resource Management & Personnel Synchronization System",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:all": "node scripts/dev.js",
    "dev:client": "pnpm --filter staffsync-client dev",
    "dev:server": "pnpm --filter staffsync-server dev",
    "client": "pnpm --filter staffsync-client dev",
    "server": "pnpm --filter staffsync-server dev",
    "server:start": "pnpm --filter staffsync-server start",
    "seed": "pnpm --filter staffsync-server seed",
    "build": "pnpm --filter staffsync-client build",
    "client:build": "pnpm --filter staffsync-client build",
    "install:all": "pnpm install"
  },
  "keywords": [
    "hrms",
